# CatSOS Root Environment Configuration (Docker Compose & Local Setup)
# Copy this file to .env:
#   cp .env.example .env

# -----------------------------------------------------------------------------
# Backend Settings
# -----------------------------------------------------------------------------
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-development-secret-key-min-32-chars-long
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Email Delivery (Console output by default for local testing)
DJANGO_EMAIL_BACKEND=config.email_backends.ServerLogConsoleEmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@catsos.local

# -----------------------------------------------------------------------------
# Frontend Settings
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Single Sign-On (Optional - fill in for Google / Microsoft OAuth)
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=placeholder-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=placeholder-google-client-id.apps.googleusercontent.com
MICROSOFT_OAUTH_CLIENT_ID=placeholder-microsoft-client-id
VITE_MICROSOFT_CLIENT_ID=placeholder-microsoft-client-id
VITE_MICROSOFT_TENANT_ID=common

# -----------------------------------------------------------------------------
# Maps & Geolocation (Overpass API)
# -----------------------------------------------------------------------------
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
NEARBY_HELP_CACHE_TTL_SECONDS=86400
